{
  "name": "vigil-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Vigil companion: live combat log analysis on a second screen for the Order of Saint Michael",
  "author": "Order of Saint Michael",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/build.mjs && electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "demo:log": "tsx scripts/demo-log.ts",
    "dist": "node scripts/build.mjs --production && electron-builder --publish never",
    "dist:mac": "node scripts/build.mjs --production && electron-builder --mac --publish never",
    "dist:win": "node scripts/build.mjs --production && electron-builder --win --publish never",
    "dist:dir": "node scripts/build.mjs --production && electron-builder --dir --publish never"
  },
  "build": {
    "appId": "org.orderofsaintmichael.vigil-companion",
    "productName": "Vigil Companion",
    "copyright": "Copyright Order of Saint Michael",
    "publish": null,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/addon",
        "to": "addon"
      }
    ],
    "protocols": [
      {
        "name": "Vigil companion pairing",
        "schemes": ["vigil-companion"]
      }
    ],
    "artifactName": "Vigil-Companion-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Vigil Companion"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@types/node": "^22.19.1",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.33.2"
}
