# Postgres. Local Docker (pnpm db:up) or a Neon connection string in production.
DATABASE_URL=postgres://osm:osm@localhost:5434/osm

# Auth.js — generate with: pnpm dlx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=
# Discord OAuth app (https://discord.com/developers/applications)
# Redirect URIs: http://localhost:3000/api/auth/callback/discord and in production
# https://guildbook.io/api/auth/callback/discord (sign-in only ever happens on the apex).
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Required on Vercel preview/production behind a proxy
AUTH_TRUST_HOST=true

# Guildbook hosts. Production: ROOT_DOMAIN=guildbook.io, AUTH_COOKIE_DOMAIN=guildbook.io, ALT_DOMAINS empty.
# To add guildbook.gg later as an alias, set ALT_DOMAINS=guildbook.gg; to make .gg primary, swap the two.
# Locally leave ROOT_DOMAIN empty: the apex is localhost:3000 (www.localhost redirects there) and guilds live on
# <slug>.localhost:3000, so the Order is osm.localhost:3000.
ROOT_DOMAIN=
# Comma-separated domains that 308-redirect to ROOT_DOMAIN (same subdomain and path).
ALT_DOMAINS=
# Session cookie shared by the apex and every guild subdomain. Leave empty locally (browsers reject Domain=localhost;
# *.localhost and custom domains receive the session through a one-time handoff instead).
AUTH_COOKIE_DOMAIN=
# Guild served on hosts that aren't the apex or a guild (*.vercel.app previews, IPs). Empty makes those hosts
# serve the platform apex. Bare localhost is always the apex. `pnpm db:seed` also uses it as the demo guild's slug.
DEFAULT_GUILD_SLUG=osm
# Legacy dev fallback: "true" serves guilds at /<guild-slug>/... on one host instead of on subdomains.
NEXT_PUBLIC_MULTI_GUILD=false
# Guilds one user may create in total, and per rolling day.
GUILD_CREATE_LIMIT=3
GUILD_CREATE_DAILY_LIMIT=2

# Custom domains. With these set, adding a domain attaches it to the Vercel project and verification also checks
# Vercel's status. Without them, verification checks the TXT record only and you attach domains in Vercel by hand.
# Token: https://vercel.com/account/tokens (scope it to the team that owns the project).
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Battle.net character verification (https://develop.battle.net/access/clients).
# Redirect URI: http://localhost:3000/api/battlenet/callback (plus https://<your-domain>/api/battlenet/callback)
BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=
# us | eu | kr | tw | cn
BATTLENET_REGION=us
# Encrypts Battle.net access tokens at rest. 32 random bytes: openssl rand -base64 32
BATTLENET_TOKEN_KEY=
# Profile API namespace for WoW: Forever; unknown until launch. {region} is substituted.
# Try profile-classic1x-{region} (Classic Era), profile-classic-{region}, or retail profile-{region}.
BATTLENET_PROFILE_NAMESPACE=profile-classic1x-{region}
# Optional: WoW: Forever realm slugs (comma-separated). When set, only characters on these realms can be verified;
# otherwise any realm that isn't a known Classic Era, Hardcore, Seasonal, Anniversary or progression realm.
BATTLENET_REALMS=
# Optional: namespaces read at link time to explain an empty result. Defaults to every Classic namespace and retail.
# BATTLENET_SCAN_NAMESPACES=profile-classic1x-{region},profile-classicann-{region},profile-classic-{region},profile-{region}
# Game Data namespace used to fill gaps in loot item names and icons. {region} is substituted.
BATTLENET_STATIC_NAMESPACE=static-classic1x-{region}
# Optional: the in-game guild, so the level sync reads the whole roster in one request.
BATTLENET_GUILD_REALM=
BATTLENET_GUILD_SLUG=
# Optional: override the OAuth redirect URI (defaults to <site origin>/api/battlenet/callback).
BATTLENET_REDIRECT_URI=
# Dev/e2e only: fake Battle.net with fixture characters. Refused when VERCEL_ENV=production.
BATTLENET_MOCK=

# Protects /api/cron/daily and /api/cron/battlenet-sync (Vercel Cron sends it as a Bearer token). openssl rand -hex 32
CRON_SECRET=
# Withdrawn and declined applications are deleted by the daily cron after this many days (default 180).
# The privacy policy shows this value.
APPLICATION_RETENTION_DAYS=

# Test-only credentials login used by Playwright. NEVER enable in production;
# the app refuses to start if this is set while VERCEL_ENV=production.
AUTH_TEST_MODE=
